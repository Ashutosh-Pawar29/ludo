# ================================================================
# Multiplayer Ludo - Production Environment Variables
# Copy this file to .env.production on your EC2 instance:
#   cp .env.production.example .env.production
# ================================================================

# [REQUIRED] EC2 Public IP address (or Public IPv4 DNS / Domain)
# This is required so LiveKit SFU knows where to route WebRTC audio/video!
# Example: 13.232.145.20
EC2_PUBLIC_IP=127.0.0.1

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ludo_secure_db_pass_2026
POSTGRES_DB=ludo

# Authentication JWT Secrets (Change these to long random strings in production!)
JWT_SECRET=ludo_super_secret_jwt_key_production_2026
REFRESHTOKEN_JWT_SECRET=ludo_super_secret_refresh_jwt_key_production_2026

# LiveKit SFU Credentials
# If running with LiveKit dev mode (default), keep devkey / secret.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
