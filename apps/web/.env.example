# ================================================================
# Vercel Frontend Environment Variables
# Configure these in your Vercel Project Settings > Environment Variables:
# ================================================================

# [REQUIRED] EC2 Backend API URL (without trailing slash)
# Example: http://13.232.145.20 or https://api.yourdomain.com
VITE_API_URL=http://13.232.145.20

# [REQUIRED] EC2 WebSocket URL (for real-time Ludo game engine)
# If using Nginx Gateway on port 80: ws://13.232.145.20/ws (or wss://api.yourdomain.com/ws)
# If connecting directly to WS port 3001: ws://13.232.145.20:3001
VITE_WS_URL=ws://13.232.145.20/ws

# [OPTIONAL] Direct LiveKit SFU URL (defaults to serverUrl returned by backend)
# Example: ws://13.232.145.20:7880 or wss://api.yourdomain.com:7880
VITE_LIVEKIT_URL=ws://13.232.145.20:7880
